{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card/v1.json",
  "serverInfo": {
    "name": "SledHaven",
    "version": "1.0.0",
    "description": "American Alpine Performance. Delivered Nationwide.",
    "homepage": "https://sledhaven.com",
    "contact": {
      "email": "concierge@sledhaven.com",
      "whatsapp": "+16266864650"
    }
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://sledhaven.com/api/mcp/"
  },
  "authentication": {
    "required": false
  },
  "capabilities": {
    "tools": [
      "list_products",
      "get_product",
      "search_products",
      "list_categories",
      "calculate_shipping"
    ],
    "resources": [
      {
        "name": "product-catalog",
        "description": "Full snowmobile and gear catalog",
        "uri": "https://sledhaven.com/shop/"
      },
      {
        "name": "blog",
        "description": "Educational buyer-guide content",
        "uri": "https://sledhaven.com/blog/"
      }
    ],
    "commerce": {
      "ordering": "human-assisted-checkout",
      "payment": [
        "crypto-BTC",
        "crypto-USDT",
        "bank-transfer",
        "zelle",
        "apple-pay",
        "chime",
        "pay-in-4"
      ],
      "currency": "USD",
      "minimumOrder": "200",
      "freeShipping": "500",
      "ships": "United States — all 50 states"
    }
  },
  "legal": {
    "ageRestriction": "none",
    "productType": "Powersports vehicles and alpine gear",
    "compliance": "Vehicles ship with Manufacturer Certificate of Origin (MCO); buyer handles state registration."
  }
}
