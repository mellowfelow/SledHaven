# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── SledHaven Reply Portal & Admin Security (Server-Only, NEVER NEXT_PUBLIC_*) ───
ADMIN_PASSCODE=

# ─── Email Transport (SMTP default via nodemailer; Resend opt-in) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SledHaven Orders <orders@sledhaven.com>"
RESEND_API_KEY=

# ─── Destination Emails (falls back to config/site.ts defaults) ───
CONTACT_EMAIL=concierge@sledhaven.com
ORDER_EMAIL=orders@sledhaven.com

# ─── Upstash Redis (Vercel Storage → Create Database) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional Live Chat Widget (Tawk.to — max one widget) ───
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
